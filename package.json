{
  "name": "impresion3d",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @impresion3d/web",
    "dev:api": "npm run dev -w @impresion3d/api",
    "build": "npm run build -w @impresion3d/web",
    "test": "npm run test -w @impresion3d/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm run start -w @impresion3d/api",
    "test:e2e": "playwright test",
    "check:production": "node scripts/check-production.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
