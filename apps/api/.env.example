NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/impresion3d
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WEB_ORIGIN=http://localhost:5173
# Set only behind exactly one trusted reverse proxy:
TRUST_PROXY=0

# En Render puede omitirse WEB_ORIGIN para usar RENDER_EXTERNAL_URL.
# Si agregás un dominio propio, configurá WEB_ORIGIN con su origen HTTPS.

# Opcional: configurá las tres para habilitar fotos de productos.
# Nunca uses estas credenciales en variables VITE_ del frontend.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Recuperación de contraseña (opcional; sin ambas variables no se envían correos)
# RESEND_API_KEY=
# EMAIL_FROM=impresión3D <cuentas@tu-dominio.com>

# Acceso social (opcional; habilitar cada par junto)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_GRAPH_VERSION=v23.0


# Confirmación de correo: con Resend configurado se activa para registros nuevos.
# REQUIRE_EMAIL_VERIFICATION=1
# Destino de avisos de pedidos (configurar en Render; no se publica en el frontend):
# ORDER_NOTIFICATION_EMAIL=

# Entregas propias: solo en backend, mantener ambas variables secretas.
# Activar Routes API y facturación en Google Cloud.
# GOOGLE_MAPS_API_KEY=
# DELIVERY_ORIGIN_ADDRESS=
